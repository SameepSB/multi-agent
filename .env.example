# Local development only. Replace the API credential with a developer-owned key.
APP_ENV=local
LOG_LEVEL=INFO
API_PORT=8080
WEATHER_AGENT_URL=http://weather-agent:5001
TRAVEL_AGENT_URL=http://travel-agent:5003
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini
REQUEST_TIMEOUT_SECONDS=30
MAX_CITIES=4
LOCAL_API_TOKEN=replace-with-a-long-random-local-api-token
LOCAL_COORDINATOR_TOKEN=replace-with-a-different-long-random-worker-token
STUB_PROVIDERS=true
NWS_USER_AGENT=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
WEATHER_A2A_AUDIENCE=
TRAVEL_A2A_AUDIENCE=
TRUSTED_COORDINATOR_OBJECT_ID=
TRAVEL_DATA_PATH=/app/data/travel_data.json
